            reachBtn.Text = "Reach"
            reachBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            reachBtn.Font = Enum.Font.GothamSemibold
            reachBtn.TextSize = 14
            Instance.new("UICorner", reachBtn).CornerRadius = UDim.new(0, 8)
            createBtnStroke(reachBtn)

            local reach2Btn = Instance.new("TextButton", panel)
            reach2Btn.Size = UDim2.new(1, -20, 0, 40)
            reach2Btn.Position = UDim2.new(0, 10, 0, 130)
            reach2Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            reach2Btn.Text = "Reach 2"
            reach2Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            reach2Btn.Font = Enum.Font.GothamSemibold
            reach2Btn.TextSize = 14
            Instance.new("UICorner", reach2Btn).CornerRadius = UDim.new(0, 8)
            createBtnStroke(reach2Btn)

            local studLabel = Instance.new("TextLabel", panel)
            studLabel.Size = UDim2.new(1, -20, 0, 20)
            studLabel.Position = UDim2.new(0, 10, 0, 180)
            studLabel.BackgroundTransparency = 1
            studLabel.Text = "Studs (1 a 100):"
            studLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            studLabel.Font = Enum.Font.Gotham
            studLabel.TextSize = 12
            studLabel.TextXAlignment = Enum.TextXAlignment.Left

            local studInput = Instance.new("TextBox", panel)
            studInput.Size = UDim2.new(0.4, 0, 0, 30)
            studInput.Position = UDim2.new(0, 10, 0, 205)
            studInput.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            studInput.TextColor3 = Color3.fromRGB(255, 255, 255)
            studInput.Font = Enum.Font.GothamBold
            studInput.TextSize = 14
            studInput.Text = tostring(REACH_STUDS)
            studInput.PlaceholderText = "Ex: 40"
            studInput.ClearTextOnFocus = true
            Instance.new("UICorner", studInput).CornerRadius = UDim.new(0, 8)
            createBtnStroke(studInput)

            local minusBtn = Instance.new("TextButton", panel)
            minusBtn.Size = UDim2.new(0.2, 0, 0, 30)
            minusBtn.Position = UDim2.new(0.45, 0, 0, 205)
            minusBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            minusBtn.Text = "-"
            minusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            minusBtn.Font = Enum.Font.GothamBold
            minusBtn.TextSize = 18
            Instance.new("UICorner", minusBtn).CornerRadius = UDim.new(0, 8)
            createBtnStroke(minusBtn)

            local plusBtn = Instance.new("TextButton", panel)
            plusBtn.Size = UDim2.new(0.2, 0, 0, 30)
            plusBtn.Position = UDim2.new(0.7, 0, 0, 205)
            plusBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            plusBtn.Text = "+"
            plusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            plusBtn.Font = Enum.Font.GothamBold
            plusBtn.TextSize = 18
            Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 8)
            createBtnStroke(plusBtn)

            studInput.FocusLost:Connect(function()
                local num = tonumber(studInput.Text)
                if num then
                    num = math.clamp(num, 1, 100)
                    if num ~= REACH_STUDS then
                        PlayTick()
                    end
                    REACH_STUDS = num
                    studInput.Text = tostring(num)
                else
                    studInput.Text = tostring(REACH_STUDS)
                end
            end)

            local function AdjustStuds(amount)
                PlayTick()
                REACH_STUDS = math.clamp(REACH_STUDS + amount, 1, 100)
                studInput.Text = tostring(REACH_STUDS)
            end

            minusBtn.MouseButton1Click:Connect(function() AdjustStuds(-1) end)
            plusBtn.MouseButton1Click:Connect(function() AdjustStuds(1) end)

            local minBtn = Instance.new("TextButton", panel)
            minBtn.Size = UDim2.new(0, 30, 0, 30)
            minBtn.Position = UDim2.new(1, -35, 0, 5)
            minBtn.BackgroundTransparency = 1
            minBtn.Text = "-"
            minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            minBtn.Font = Enum.Font.GothamBold
            minBtn.TextSize = 20

            local floatingBtn = Instance.new("TextButton", sg)
            floatingBtn.Size = UDim2.new(0, 45, 0, 45)
            floatingBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            floatingBtn.Text = "+"
            floatingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            floatingBtn.Font = Enum.Font.GothamBold
            floatingBtn.TextSize = 24
            floatingBtn.Visible = false
            floatingBtn.Active = true
            Instance.new("UICorner", floatingBtn).CornerRadius = UDim.new(1, 0)

            local floatStroke = Instance.new("UIStroke", floatingBtn)
            floatStroke.Color = Color3.fromRGB(255, 255, 255)
            floatStroke.Thickness = 1.5

            local dragging, dragStart, startPos
            floatingBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    dragStart = input.Position
                    startPos = floatingBtn.Position
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
                    local delta = input.Position - dragStart
                    floatingBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)

            local function ToggleMinimize()
                PlayClick()
                if panel.Visible then
                    local lastPos = panel.Position
                    panel.Visible = false
                    floatingBtn.Visible = true
                    floatingBtn.Position = UDim2.new(lastPos.X.Scale, lastPos.X.Offset + 80, lastPos.Y.Scale, lastPos.Y.Offset + 100)
                else
                    panel.Visible = true
                    floatingBtn.Visible = false
                    panel.Position = UDim2.new(floatingBtn.Position.X.Scale, floatingBtn.Position.X.Offset - 80, floatingBtn.Position.Y.Scale, floatingBtn.Position.Y.Offset - 100)
                end
            end

            local function UpdateButtons()
                if frozen then
                    optBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    optBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
                    optBtn.Text = "Otimização Ativada"
                else
                    optBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                    optBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    optBtn.Text = "Otimização"
                end

                if lagging then
                    reachBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    reachBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
                    reachBtn.Text = "Reach Ativado"
                else
                    reachBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                    reachBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    reachBtn.Text = "Reach"
                end

                if reach2Active then
                    reach2Btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    reach2Btn.TextColor3 = Color3.fromRGB(0, 0, 0)
                    reach2Btn.Text = "Reach 2 Ativado"
                else
                    reach2Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                    reach2Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    reach2Btn.Text = "Reach 2"
                end
            end

            local function ToggleOtimizacao()
                PlayClick()
                frozen = not frozen
                if frozen then
                    FreezeBall()
                    lagging = true
                    AtivarLag()
                else
                    UnfreezeBall()
                    lagging = false
                    DesativarLag()
                end
                UpdateButtons()
            end

            local function ToggleReach()
                PlayClick()
                lagging = not lagging
                if lagging then
                    AtivarLag()
                else
                    DesativarLag()
                end
                UpdateButtons()
            end

            local function ToggleReach2()
                PlayClick()
                reach2Active = not reach2Active
                if not reach2Active then
                    RestaurarReach2()
                end
                UpdateButtons()
            end

            optBtn.MouseButton1Click:Connect(ToggleOtimizacao)
            reachBtn.MouseButton1Click:Connect(ToggleReach)
            reach2Btn.MouseButton1Click:Connect(ToggleReach2)
            minBtn.MouseButton1Click:Connect(ToggleMinimize)
            floatingBtn.MouseButton1Click:Connect(ToggleMinimize)

            UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if input.KeyCode == Enum.KeyCode.C then
                    ToggleOtimizacao()
                elseif input.KeyCode == Enum.KeyCode.B then
                    ToggleReach()
                elseif input.KeyCode == Enum.KeyCode.N then
                    ToggleReach2()
                elseif input.KeyCode == Enum.KeyCode.V then
                    ToggleMinimize()
                end
            end)

            UpdateButtons()
            print("MATIAS OPTIMIZER FPS carregado com sistema de som!")
        end)
    end,
})

