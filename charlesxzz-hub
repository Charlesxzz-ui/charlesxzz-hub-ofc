            BotaoMin.MouseButton1Click:Connect(function()
                minimizado = not minimizado
                for _, b in ipairs(listaBotoes) do
                    b.Visible = not minimizado
                end
                Frame.Size = minimizado and UDim2.new(0, 230, 0, 40) or UDim2.new(0, 230, 0, 290)
            end)

            UIS.InputBegan:Connect(function(input, processado)
                if processado then return end
