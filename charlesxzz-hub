local function OpenKeyScreen()
    if keyUnlocked then
        return
    end
    KeyGui.Enabled = true
    KeyScale.Scale = 0.94

    TweenService:Create(
        KeyScale,
        TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Scale = 1 }
    ):Play()

    keyConn = RunService.RenderStepped:Connect(function(dt)
        if keyUnlocked then
            return
        end
        KeyGradient.Rotation = (KeyGradient.Rotation + dt * 95) % 360
    end)
end

