ScriptsTab:Button({
    Title = "DDEUS HUB ⚡",
    Locked = false,
    Callback = function()
        RunInlineScript("DDEUS HUB ⚡", function()
            local Lighting = game:GetService("Lighting")

            local Config = {
                Active = {
                    NoClip = false,
                    BallControl = false,
                    Atravessar = false,
                    Disarm = false,
                    Reaction = true,
                    AntiLag = false,
                    BigKick = false
                },
                Values = {
                    ReactionTime = 0.25,
                    BallControlDistance = 2.5,
                    BallPullStrength = 35,
                    BigKickForce = 180
                }
            }

            local Char, Root
            local function UpdateChar()
                Char = LocalPlayer.Character
                if Char then
                    Root = Char:WaitForChild("HumanoidRootPart")
                end
            end
            UpdateChar()
            LocalPlayer.CharacterAdded:Connect(UpdateChar)

            local function GetBall()
                return workspace:FindFirstChild("Ball")
                    or workspace:FindFirstChild("Football")
            end

            local lastReact = 0
            local function CanReact()
                if not Config.Active.Reaction then
                    return true
                end
                local now = tick()
                if now - lastReact >= Config.Values.ReactionTime then
                    lastReact = now
                    return true
                end
                return false
            end

            local function TrueNoClip()
                if not Char then return end
                for _, part in ipairs(Char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end

            local savedCollision = {}
            local function Atravessar()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        for _, part in ipairs(p.Character:GetChildren()) do
                            if part:IsA("BasePart") then
                                if savedCollision[part] == nil then
                                    savedCollision[part] = part.CanCollide
                                end
                                part.CanCollide = false
                            end
                        end
                    end
                end
            end

            local function RestaurarColisao()
                for part, oldValue in pairs(savedCollision) do
                    if part and part.Parent then
                        part.CanCollide = oldValue
                    end
                end
                table.clear(savedCollision)
            end

            local function BallControl()
                local ball = GetBall()
                if not ball or not Root then
                    return
                end
                local target =
                    Root.Position
                    + Root.CFrame.LookVector * Config.Values.BallControlDistance
                    + Vector3.new(0, -1.5, 0)
                local offset = target - ball.Position
                local distance = offset.Magnitude
                if distance > 40 then
                    return
                end
                if distance > 0.15 then
                    local strength = math.clamp(distance * Config.Values.BallPullStrength, 0, 90)
                    ball.AssemblyLinearVelocity = offset.Unit * strength
                else
                    ball.AssemblyLinearVelocity = Vector3.zero
                end
            end

            local function Disarm()
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local tool = p.Character:FindFirstChildOfClass("Tool")
                        if hrp and tool and Root then
                            if (hrp.Position - Root.Position).Magnitude <= 10 then
                                tool.Parent = p.Backpack
                            end
                        end
                    end
                end
            end

            local function AntiLag()
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 1e9
                pcall(function()
                    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                end)
            end

            RunService.Heartbeat:Connect(function()
                if Config.Active.AntiLag then
                    AntiLag()
                end
                if not CanReact() then
                    return
                end
                if Config.Active.NoClip then
                    TrueNoClip()
                end
                if Config.Active.Atravessar then
                    Atravessar()
                end
                if Config.Active.BallControl then
                    BallControl()
                end
                if Config.Active.Disarm then
                    Disarm()
                end
            end)

            local gui = Instance.new("ScreenGui")
            gui.Name = "DDeusHubB50"
            gui.ResetOnSpawn = false
            gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

            local main = Instance.new("Frame")
            main.Parent = gui
            main.Size = UDim2.new(0, 280, 0, 400)
            main.Position = UDim2.new(0.5, -140, 0.5, -200)
            main.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            main.Active = true
            main.Draggable = true
            Instance.new("UICorner", main)

            local title = Instance.new("TextLabel")
            title.Parent = main
            title.Size = UDim2.new(1, 0, 0, 40)
            title.Text = "🧲 DDeus Hub B50"
            title.Font = Enum.Font.GothamBold
            title.TextSize = 14
            title.TextColor3 = Color3.fromRGB(0, 255, 150)
            title.BackgroundTransparency = 1

            local function Button(text, key, y)
                local button = Instance.new("TextButton")
                button.Parent = main
                button.Size = UDim2.new(1, -20, 0, 35)
                button.Position = UDim2.new(0, 10, 0, y)
                button.Font = Enum.Font.Gotham
                button.TextSize = 12
                button.TextColor3 = Color3.new(1, 1, 1)
                Instance.new("UICorner", button)

                local function UpdateButton()
                    local enabled = Config.Active[key]
                    button.Text = text .. (enabled and " [ON]" or " [OFF]")
                    button.BackgroundColor3 = enabled and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(40, 40, 50)
                end

                UpdateButton()

                button.MouseButton1Click:Connect(function()
                    Config.Active[key] = not Config.Active[key]
                    if key == "Atravessar" and not Config.Active[key] then
                        RestaurarColisao()
                    end
                    UpdateButton()
                end)
            end

            Button("👻 NoClip", "NoClip", 50)
            Button("⚽ Atrair Bola", "BallControl", 90)
            Button("🧲 Atravessar", "Atravessar", 130)
            Button("🔫 Desarme", "Disarm", 170)
            Button("🚀 No Lag", "AntiLag", 210)
            Button("💥 Chute Power", "BigKick", 250)
            Button("⏱ Tempo de Reação", "Reaction", 290)

            print("⚡ DDeus Hub B50 carregado!")
        end)
    end,
