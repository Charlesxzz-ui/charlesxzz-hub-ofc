local function CloseKeyScreenAndOpenHub()
    if keyUnlocked then
        return
    end
    keyUnlocked = true

    if keyConn then
        keyConn:Disconnect()
        keyConn = nil
    end

    KeyFeedbackLabel.Text = "Key correta! Abrindo o HUB..."
    KeyFeedbackLabel.TextColor3 = Color3.fromRGB(115, 255, 145)

    TweenService:Create(
        KeyScale,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Scale = 0.92 }
    ):Play()

    for _, obj in ipairs(KeyCard:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            TweenService:Create(obj, TweenInfo.new(0.16), { TextTransparency = 1 }):Play()
        elseif obj:IsA("Frame") and obj ~= KeyTint then
            TweenService:Create(obj, TweenInfo.new(0.16), { BackgroundTransparency = 1 }):Play()
        elseif obj:IsA("ImageLabel") then
            TweenService:Create(obj, TweenInfo.new(0.16), { ImageTransparency = 1 }):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, TweenInfo.new(0.16), { Transparency = 1 }):Play()
        end
    end

    local fade = TweenService:Create(
        KeyCard,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { BackgroundTransparency = 1 }
    )
    fade:Play()
    fade.Completed:Wait()

    if KeyGui then
        KeyGui:Destroy()
    end

    if type(OpenScriptHubUnlocked) == "function" then
        OpenScriptHubUnlocked()
    end
end

local function CheckKeyInput()
    if keyUnlocked then
        return
    end
    local typedKey = string.match(KeyInput.Text or "", "^%s*(.-)%s*$")
    if typedKey == RequiredKey then
        CloseKeyScreenAndOpenHub()
    else
        KeyFeedbackLabel.Text = "❌ Key incorreta! Tente novamente."
        KeyFeedbackLabel.TextColor3 = Color3.fromRGB(255, 95, 95)
        KeyInputStroke.Color = Color3.fromRGB(255, 95, 95)
        task.delay(0.8, function()
            if KeyInputStroke and KeyInputStroke.Parent then
                KeyInputStroke.Color = Color3.fromRGB(255, 210, 35)
            end
        end)
    end
end

