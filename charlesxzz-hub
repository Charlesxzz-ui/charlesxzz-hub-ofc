    TweenService:Create(
        WelcomeScale,
        TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Scale = 0.92 }
    ):Play()

    for _, obj in ipairs(WelcomeCard:GetDescendants()) do
