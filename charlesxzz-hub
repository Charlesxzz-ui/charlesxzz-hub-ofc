-- 115. PAINEL ZAG ⚡ (Script Lua direto - Brookhaven - Painel do Zagueiro V2)
ScriptsTab:Button({
    Title = "PAINEL ZAG ⚡",
    Locked = false,
    Callback = function()
        RunInlineScript("PAINEL ZAG ⚡", function()
            local UIS = game:GetService("UserInputService")
            local RS = game:GetService("RunService")
            local Workspace = game:GetService("Workspace")
            local jogador = LocalPlayer

            local CFG = {
                TECLA = "E",
                DISTANCIA = 3,
                ALTURA_CHAO = 3,
                autoDesarme = false,
                antiPulo = false,
                superChute = false,
                reachGrande = false,
                atravessar = false,
                RAIO_DESARME = 8,
                FORCA_SUPER_CHUTE = 60,
                FORCA_DESARME = 30,
                FORCA_CHUTE_NORMAL = 15
            }

            local character = jogador.Character or jogador.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart")

            local conduzindo = false
            local teclaPressionada = false
            local bolaAtual = nil
            local bodyPosition, bodyAngular = nil, nil
            local ultimoDesarme = 0
            local pastaBolas = nil

            local function atualizarPasta()
                pastaBolas = Workspace:FindFirstChild("WorkspaceCom")
                    and Workspace.WorkspaceCom:FindFirstChild("001_SoccerBalls")
                    or Workspace:FindFirstChild("001_SoccerBalls", true)
            end
            atualizarPasta()

            local function acharBolaPerto()
                if not hrp then return nil end
                if not pastaBolas then
                    atualizarPasta()
                    if not pastaBolas then return nil end
                end

                local raio = CFG.reachGrande and 120 or 60
                local maisPerto, menorDist = nil, raio

                for _, bola in ipairs(pastaBolas:GetChildren()) do
                    if bola:IsA("BasePart") and bola.Name:match("^Soccer") then
                        local dist = (bola.Position - hrp.Position).Magnitude
                        if dist < menorDist then
                            menorDist = dist
                            maisPerto = bola
                        end
                    end
                end
                return maisPerto
            end

            local function limpar()
                if bodyPosition and bodyPosition.Parent then bodyPosition:Destroy() end
                if bodyAngular and bodyAngular.Parent then bodyAngular:Destroy() end
                bodyPosition, bodyAngular = nil, nil
            end

            local function atualizarBola(bola)
                if not bola or not bola.Parent or not hrp then return end

                local dir = hrp.CFrame.LookVector
                local alvo = hrp.Position + (dir * CFG.DISTANCIA)
                alvo = Vector3.new(alvo.X, hrp.Position.Y - CFG.ALTURA_CHAO + 0.8, alvo.Z)

                if not bodyPosition or bodyPosition.Parent ~= bola then
                    bodyPosition = Instance.new("BodyPosition")
                    bodyPosition.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bodyPosition.P = 5000
                    bodyPosition.D = 300
                    bodyPosition.Parent = bola
                end
                bodyPosition.Position = alvo

                local vel = hrp.Velocity.Magnitude
                local giro = math.max(vel * 1.5, 2)
                if not bodyAngular or bodyAngular.Parent ~= bola then
                    bodyAngular = Instance.new("BodyAngularVelocity")
                    bodyAngular.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                    bodyAngular.Parent = bola
                end
                bodyAngular.AngularVelocity = Vector3.new(giro, 0, 0)
            end

            local function chutarBola(bola, forca)
                if not bola or not bola.Parent or not hrp then return end
                pcall(function() bola.Anchored = false end)
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = (hrp.CFrame.LookVector * forca) + Vector3.new(0, forca * 0.12, 0)
                bv.Parent = bola
                task.delay(0.2, function()
                    pcall(function() bv:Destroy() end)
                end)
            end

            local function aplicarNoclip(ativo)
                if not character then return end
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = not ativo
                    end
                end
            end

            local function autoDesarme()
                if not CFG.autoDesarme or conduzindo then return end
                if not hrp then return end

                local agora = tick()
                if agora - ultimoDesarme < 1 then return end

                local bola = acharBolaPerto()
                if bola and bola.Parent then
                    local dist = (bola.Position - hrp.Position).Magnitude
                    local raio = CFG.reachGrande and (CFG.RAIO_DESARME * 2) or CFG.RAIO_DESARME
                    if dist <= raio then
                        local forca = CFG.superChute and CFG.FORCA_SUPER_CHUTE or CFG.FORCA_DESARME
                        chutarBola(bola, forca)
                        ultimoDesarme = agora
                    end
                end
            end

            local function antiPulo()
                if not CFG.antiPulo or not bolaAtual or not bolaAtual.Parent then return end
                pcall(function()
                    if bolaAtual.Position.Y > hrp.Position.Y - 1 then
                        bolaAtual.Velocity = Vector3.new(bolaAtual.Velocity.X, 0, bolaAtual.Velocity.Z)
                    end
                end)
            end

            local cont = 0
            RS.Heartbeat:Connect(function()
                if jogador.Character and jogador.Character:FindFirstChild("HumanoidRootPart") then
                    character = jogador.Character
                    hrp = character.HumanoidRootPart
                end

                if conduzindo and teclaPressionada then
                    if not bolaAtual or not bolaAtual.Parent then
                        bolaAtual = acharBolaPerto()
                        if bolaAtual and CFG.atravessar then aplicarNoclip(true) end
                    end
                    if bolaAtual then
                        atualizarBola(bolaAtual)
                        if CFG.antiPulo then antiPulo() end
                    end
                else
                    if bodyPosition or bodyAngular then
                        limpar()
                        if CFG.atravessar then aplicarNoclip(false) end
                    end
                    bolaAtual = nil
                end

                cont = cont + 1
                if cont % 10 == 0 then
                    autoDesarme()
                end
            end)

            UIS.InputBegan:Connect(function(input, processado)
                if processado then return end
                if input.KeyCode == Enum.KeyCode[CFG.TECLA] then
                    teclaPressionada = true
                    conduzindo = true
                    bolaAtual = acharBolaPerto()
                    if not bolaAtual then
                        conduzindo = false
                    end
                end
            end)

            UIS.InputEnded:Connect(function(input, processado)
                if processado then return end
                if input.KeyCode == Enum.KeyCode[CFG.TECLA] then
                    if bolaAtual and bolaAtual.Parent then
                        local forca = CFG.superChute and CFG.FORCA_SUPER_CHUTE or CFG.FORCA_CHUTE_NORMAL
                        chutarBola(bolaAtual, forca)
                    end
                    limpar()
                    if CFG.atravessar then aplicarNoclip(false) end
                    teclaPressionada = false
                    conduzindo = false
                    bolaAtual = nil
                end
            end)

            jogador.CharacterAdded:Connect(function(novoChar)
                limpar()
                character = novoChar
                hrp = novoChar:WaitForChild("HumanoidRootPart")
                conduzindo = false
                teclaPressionada = false
                bolaAtual = nil
                atualizarPasta()
            end)

            local ScreenGui = Instance.new("ScreenGui")
            ScreenGui.Name = "ZagueiroPanel"
            ScreenGui.ResetOnSpawn = false
            ScreenGui.Parent = jogador:WaitForChild("PlayerGui")

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(0, 230, 0, 290)
            Frame.Position = UDim2.new(0, 15, 0.3, 0)
            Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            Frame.BorderSizePixel = 0
            Frame.Active = true
            Frame.Draggable = true
            Frame.Parent = ScreenGui
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 10)

            local Titulo = Instance.new("TextLabel")
            Titulo.Size = UDim2.new(1, -35, 0, 35)
            Titulo.Text = "🛡️ PAINEL ZAGUEIRO"
            Titulo.TextColor3 = Color3.fromRGB(255, 255, 255)
            Titulo.BackgroundTransparency = 1
            Titulo.Font = Enum.Font.GothamBold
            Titulo.TextSize = 16
            Titulo.TextXAlignment = Enum.TextXAlignment.Left
            Titulo.Position = UDim2.new(0, 10, 0, 0)
            Titulo.Parent = Frame

            local minimizado = false
            local BotaoMin = Instance.new("TextButton")
            BotaoMin.Size = UDim2.new(0, 25, 0, 25)
            BotaoMin.Position = UDim2.new(1, -30, 0, 5)
            BotaoMin.Text = "—"
            BotaoMin.TextColor3 = Color3.fromRGB(255, 255, 255)
            BotaoMin.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
            BotaoMin.Font = Enum.Font.GothamBold
            BotaoMin.TextSize = 14
            BotaoMin.Parent = Frame
            Instance.new("UICorner", BotaoMin).CornerRadius = UDim.new(0, 6)

            local listaBotoes = {}

            local function criarToggle(nome, ordem, config)
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -16, 0, 34)
                btn.Position = UDim2.new(0, 8, 0, 40 + (ordem - 1) * 40)
                btn.Text = nome .. ": OFF"
                btn.TextColor3 = Color3.fromRGB(200, 60, 60)
                btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
                btn.Font = Enum.Font.Gotham
                btn.TextSize = 13
                btn.Parent = Frame
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

                btn.MouseButton1Click:Connect(function()
