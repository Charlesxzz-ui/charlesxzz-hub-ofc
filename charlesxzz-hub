                if not p:IsA("BasePart") then return false end
                if p:IsA("Part") and p.Shape == Enum.PartType.Ball then return true end
                if p.Name:lower():find("ball") or p.Name:lower():find("football") then return true end
                return false
            end

            local function GetBall()
                for _, v in ipairs(workspace:GetDescendants()) do
                    if isBall(v) then return v end
                end
                return workspace:FindFirstChild("Ball") or workspace:FindFirstChild("Football")
            end

            local function CleanBodyPos(ball)
                if not ball then return end
                local bp = ball:FindFirstChild("__FreezeBP")
                if bp then bp:Destroy() end
                local bv = ball:FindFirstChild("__FreezeBV")
                if bv then bv:Destroy() end
            end

            local function FreezeBall()
                local ball = GetBall()
                if not ball then return end
                frozenBall = ball
                frozenPos = ball.Position

