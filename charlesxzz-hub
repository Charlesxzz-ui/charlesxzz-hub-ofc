OpenWelcomeScreen = function()
    if welcomeClosed or welcomeActive then
        return
    end
    welcomeActive = true
    WelcomeGui.Enabled = true
    WelcomeScale.Scale = 0.94

    TweenService:Create(
        WelcomeScale,
        TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Scale = 1 }
    ):Play()

    local elapsed = 0
    local duration = 120
    welcomeConn = RunService.RenderStepped:Connect(function(dt)
        if welcomeClosed or not welcomeActive then
            return
        end
        WelcomeGradient.Rotation = (WelcomeGradient.Rotation + dt * 95) % 360
        elapsed += dt
        local remaining = math.max(0, math.ceil(duration - elapsed))
        local mins = math.floor(remaining / 60)
        local secs = remaining % 60
        TimerLabel.Text = string.format("⏰ %02d:%02d", mins, secs)
        if remaining <= 0 then
            CloseWelcomeScreen(true)
        end
    end)
end

